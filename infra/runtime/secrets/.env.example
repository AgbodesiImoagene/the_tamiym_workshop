# TTW-065 — production runtime secrets template
# Copy to the Droplet as root-owned /etc/tamiym/secrets.env (mode 0600).
# Replace every PLACEHOLDER_* value out-of-band. NEVER commit real values.
# OpenTofu must not read, template, or output this file.

# --- Database (app role; migration/backup URLs stay in owner vault only) ---
DATABASE_URL=PLACEHOLDER_DATABASE_URL

# --- JWT ---
JWT_ACCESS_SECRET=PLACEHOLDER_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=PLACEHOLDER_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Valkey / Redis (host-local; TTW-064) ---
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=PLACEHOLDER_VALKEY_PASSWORD
REDIS_DB=0
VALKEY_PASSWORD=PLACEHOLDER_VALKEY_PASSWORD

# --- Paystack ---
PAYSTACK_SECRET_KEY=PLACEHOLDER_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=PLACEHOLDER_PAYSTACK_PUBLIC_KEY

# --- S3-compatible Spaces (app keys — not OpenTofu state backend keys) ---
S3_ENDPOINT=PLACEHOLDER_S3_ENDPOINT
S3_PUBLIC_URL=PLACEHOLDER_S3_PUBLIC_URL
S3_BUCKET=PLACEHOLDER_S3_BUCKET
S3_ACCESS_KEY=PLACEHOLDER_S3_ACCESS_KEY
S3_SECRET_KEY=PLACEHOLDER_S3_SECRET_KEY
S3_REGION=PLACEHOLDER_S3_REGION

# --- Mail / SMS (optional until delivery is required) ---
MAIL_HOST=PLACEHOLDER_MAIL_HOST
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=PLACEHOLDER_MAIL_USER
MAIL_PASSWORD=PLACEHOLDER_MAIL_PASSWORD
MAIL_FROM=PLACEHOLDER_MAIL_FROM
# TERMII_API_KEY=PLACEHOLDER_TERMII_API_KEY
# TERMII_SENDER_ID=PLACEHOLDER_TERMII_SENDER_ID

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_CLIENT_SECRET
# GOOGLE_CALLBACK_URL=PLACEHOLDER_GOOGLE_CALLBACK_URL

# --- Optional AI moderation ---
# OPENAI_API_KEY=PLACEHOLDER_OPENAI_API_KEY

# --- Media malware scan (TTW-021; production must use ClamAV) ---
VIRUS_SCANNER=clamav
CLAMAV_HOST=PLACEHOLDER_CLAMAV_HOST
CLAMAV_PORT=3310
VIRUS_SCAN_TIMEOUT_MS=15000
MEDIA_FETCH_TIMEOUT_MS=10000

# --- Non-secret runtime config (still host-managed for one file) ---
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
# Compose sets API_ROLE per service (api|worker|scheduler). Local default: all.
# API_ROLE=all
CORS_ORIGIN=PLACEHOLDER_CORS_ORIGIN
AUTH_ADMIN_ORIGINS=PLACEHOLDER_AUTH_ADMIN_ORIGINS
AUTH_CUSTOMER_ORIGINS=PLACEHOLDER_AUTH_CUSTOMER_ORIGINS
FRONTEND_URL=PLACEHOLDER_FRONTEND_URL
ADMIN_APP_URL=PLACEHOLDER_ADMIN_APP_URL
# --- OpenTelemetry (TTW-066; managed OTLP destination — never commit real values) ---
OTEL_EXPORTER_OTLP_ENDPOINT=PLACEHOLDER_OTEL_EXPORTER_OTLP_ENDPOINT
# Optional auth header value for the managed destination (e.g. Bearer …). Keep PLACEHOLDER until owner injects.
OTEL_EXPORTER_OTLP_AUTH_HEADER=PLACEHOLDER_OTEL_EXPORTER_OTLP_AUTH_HEADER
OTEL_DEPLOYMENT_ENVIRONMENT=production
# OTEL_SERVICE_NAME is usually set per Compose service; example only:
# OTEL_SERVICE_NAME=api

# Optional migration URL (compose migrate profile). Prefer owner vault over app role.
# MIGRATION_DATABASE_URL=PLACEHOLDER_MIGRATION_DATABASE_URL

# DO NOT put provider API tokens or state-backend Spaces keys in this file.
