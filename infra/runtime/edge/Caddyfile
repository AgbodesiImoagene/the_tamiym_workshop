# TTW-063 — Droplet edge Caddyfile (ACME HTTP-01).
# Hostnames default to production; override via Caddy env or fork for tmpval.
{
	email {$CADDY_ACME_EMAIL:ops@tamiym.com}
}

{$WEB_HOSTNAME:www.tamiym.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}

{$APP_HOSTNAME:app.tamiym.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:3002
}

{$ADMIN_HOSTNAME:admin.tamiym.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy admin:3003
}

{$API_HOSTNAME:api.tamiym.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 2MB
	}
	# Paystack webhooks: preserve raw body; do not buffer/mutate.
	reverse_proxy api:3001
}

{$APEX_HOSTNAME:tamiym.com} {
	redir https://{$WEB_HOSTNAME:www.tamiym.com}{uri} permanent
}
