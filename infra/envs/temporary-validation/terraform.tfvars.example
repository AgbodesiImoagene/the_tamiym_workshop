# Copy to terraform.tfvars for local overrides (do not commit secrets).
project                = "tamiym-workshop"
environment_label      = "temporary-validation"
managed_by             = "opentofu"
ticket                 = "TTW-063"
do_project_name        = "ttw-tmpval"
do_project_purpose     = "Web Application"
do_project_environment = "Development"
region                 = "lon1"
vpc_name               = "ttw-tmpval-vpc"
vpc_ip_range           = "10.20.0.0/16"
firewall_name          = "ttw-tmpval-edge"
# Replace with operator admin CIDRs before apply. Never use 0.0.0.0/0.
ssh_source_cidrs       = ["127.0.0.1/32"]
root_domain            = "tmpval.tamiym.com"
web_hostname           = "www.tmpval.tamiym.com"
app_hostname           = "app.tmpval.tamiym.com"
admin_hostname         = "admin.tmpval.tamiym.com"
api_hostname           = "api.tmpval.tamiym.com"
customer_cookie_domain = ".tmpval.tamiym.com"
admin_cookie_domain    = "admin.tmpval.tamiym.com"
postgres_name          = "ttw-tmpval-pg"
postgres_size          = "db-s-1vcpu-1gb"
postgres_version       = "16"
spaces_name_prefix     = "ttw-tmpval"
spaces_region          = "ams3"
enable_app_droplet               = false
droplet_name                     = "ttw-tmpval-app"
droplet_size                     = "s-2vcpu-4gb"
droplet_image                    = "ubuntu-24-04-x64"
droplet_ssh_key_fingerprints     = []
