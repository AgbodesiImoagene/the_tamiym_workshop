# Copy to terraform.tfvars for local overrides (do not commit secrets).
project                = "tamiym-workshop"
environment_label      = "production"
managed_by             = "opentofu"
ticket                 = "TTW-063"
do_project_name        = "ttw-prod"
do_project_purpose     = "Web Application"
do_project_environment = "Production"
region                 = "lon1"
vpc_name               = "ttw-prod-vpc"
vpc_ip_range           = "10.10.0.0/16"
firewall_name          = "ttw-prod-edge"
# Replace with operator admin CIDRs before apply. Never use 0.0.0.0/0.
ssh_source_cidrs       = ["127.0.0.1/32"]
root_domain            = "thetamiymworkshop.com"
web_hostname           = "www.thetamiymworkshop.com"
app_hostname           = "app.thetamiymworkshop.com"
admin_hostname         = "admin.thetamiymworkshop.com"
api_hostname           = "api.thetamiymworkshop.com"
customer_cookie_domain = ".thetamiymworkshop.com"
admin_cookie_domain    = "admin.thetamiymworkshop.com"
postgres_name          = "ttw-prod-pg"
postgres_size          = "db-s-1vcpu-1gb"
postgres_version       = "16"
spaces_name_prefix     = "ttw-prod"
spaces_region          = "ams3"
# Owner-gated: set true + SSH fingerprints only when applying the Droplet.
enable_app_droplet               = false
droplet_name                     = "ttw-prod-app"
droplet_size                     = "s-2vcpu-4gb"
droplet_image                    = "ubuntu-24-04-x64"
droplet_ssh_key_fingerprints     = []
