# syntax=docker/dockerfile:1.7
# Multi-stage Next.js standalone image (TTW-063).
# Build: docker build -f docker/Dockerfile.next --build-arg APP_NAME=web -t tamiym-web .
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/app/package.json apps/app/
COPY apps/admin/package.json apps/admin/
COPY apps/api/package.json apps/api/
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG APP_NAME=web
COPY . .
# Dummy DATABASE_URL for workspace packages that may touch Prisma tooling.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
RUN pnpm --filter @tamiym/types build \
  && pnpm --filter ${APP_NAME} build

FROM node:${NODE_VERSION}-bookworm-slim AS runner
ARG APP_NAME=web
ARG APP_PORT=3000
ENV NODE_ENV=production
ENV PORT=${APP_PORT}
ENV HOSTNAME=0.0.0.0
WORKDIR /app

RUN groupadd --system --gid 10001 tamiym \
  && useradd --system --uid 10001 --gid tamiym --create-home tamiym

COPY --from=build --chown=tamiym:tamiym /repo/apps/${APP_NAME}/.next/standalone ./
COPY --from=build --chown=tamiym:tamiym /repo/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=build --chown=tamiym:tamiym /repo/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

USER tamiym
EXPOSE ${APP_PORT}
ENV APP_NAME=${APP_NAME}
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3000')).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node apps/${APP_NAME}/server.js"]
