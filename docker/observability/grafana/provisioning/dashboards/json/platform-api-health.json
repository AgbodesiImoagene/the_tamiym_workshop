        {
          "expr": "tamiym:http_request_duration_ms:p95_5m",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "HTTP request latency p95 (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
