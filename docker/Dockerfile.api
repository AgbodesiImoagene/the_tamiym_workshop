# syntax=docker/dockerfile:1.7
# NestJS API image reused for api / worker / scheduler / migrate (TTW-063).
# Build: docker build -f docker/Dockerfile.api -t tamiym-api .
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/app/package.json apps/app/
COPY apps/admin/package.json apps/admin/
COPY apps/api/package.json apps/api/
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
RUN pnpm --filter api exec prisma generate \
  && pnpm --filter api build

FROM node:${NODE_VERSION}-bookworm-slim AS runner
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV API_ROLE=api
WORKDIR /app

RUN groupadd --system --gid 10001 tamiym \
  && useradd --system --uid 10001 --gid tamiym --create-home tamiym \
  && apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=tamiym:tamiym /repo/apps/api/dist ./dist
COPY --from=build --chown=tamiym:tamiym /repo/apps/api/package.json ./package.json
COPY --from=build --chown=tamiym:tamiym /repo/apps/api/prisma ./prisma
COPY --from=build --chown=tamiym:tamiym /repo/apps/api/src/generated ./src/generated
COPY --from=build --chown=tamiym:tamiym /repo/node_modules ./node_modules
COPY --from=build --chown=tamiym:tamiym /repo/apps/api/node_modules ./apps/api/node_modules

USER tamiym
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3001')+'/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
