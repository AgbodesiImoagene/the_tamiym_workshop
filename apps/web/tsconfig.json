{
  "extends": "@tamiym/config/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@tamiym/ui": ["../../packages/ui/src"],
      "@tamiym/types": ["../../packages/types/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
