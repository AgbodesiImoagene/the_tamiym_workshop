# Test database (use a separate DB or schema for integration tests)
DATABASE_URL="postgresql://user:password@localhost:5432/tamiym_workshop_test?schema=public"

# JWT (same as dev for unit tests; use test values for e2e if needed)
JWT_ACCESS_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Paystack mock keys (never use real keys in tests)
PAYSTACK_SECRET_KEY="sk_test_mock"
PAYSTACK_PUBLIC_KEY="pk_test_mock"

# Server
PORT=3001
NODE_ENV=test

# Redis (optional for tests)
REDIS_HOST=localhost
REDIS_PORT=6379
