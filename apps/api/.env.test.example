# Test database (use a separate DB or schema for integration tests)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tamiym_workshop_test?schema=public"

# JWT (must not be the placeholder values rejected by AuthModule)
JWT_ACCESS_SECRET="test-access-secret-ttw003-not-for-prod"
JWT_REFRESH_SECRET="test-refresh-secret-ttw003-not-for-prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Paystack mock keys (never use real keys in tests)
PAYSTACK_SECRET_KEY="sk_test_mock"
PAYSTACK_PUBLIC_KEY="pk_test_mock"

# Server
PORT=3001
NODE_ENV=test

# Redis — use a dedicated logical DB so e2e teardown can FLUSHDB safely
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15

# Mail (Mailhog/local sink; not required for smoke e2e)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# S3 Storage (optional for smoke e2e)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_PUBLIC_URL="http://127.0.0.1:9000/tamiym-assets"
S3_BUCKET="tamiym-assets"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
