# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tamiym_workshop?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="your-access-secret-key-change-in-production-"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production-"
JWT_ACCESS_EXPIRES_IN="15m"
MFA_TOTP_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Paystack (signature verification uses PAYSTACK_SECRET_KEY for x-paystack-signature)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# Mail (SMTP; local dev often uses Mailpit/Mailhog on 1025)
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE="false"
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM="\"Tamiym\" <noreply@tamiym.com>"

# Optional: notify this address when a customer places an order (ops inbox)
# ORDER_PLACE_NOTIFICATION_EMAIL="ops@example.com"

# SMS (Termii Nigeria). SMS_PROVIDER=log logs only; use termii when TERMII_API_KEY is set.
# SMS_PROVIDER="log"
# TERMII_API_KEY=
# TERMII_SENDER_ID="Tamiym"

# Optional: middle “critical” inventory tier (positive integer). Crossing from above this level
# to at or below it notifies once; out-of-stock still wins if both apply. Omit to disable.
# LOW_INVENTORY_CRITICAL_THRESHOLD=3

# Notification outbox delivery (transactional email retries)
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=8
NOTIFICATION_OUTBOX_STALE_PROCESSING_MINUTES=15
# TTW-043 delivery SLO targets (metrics/alerts)
NOTIFICATION_SLO_PENDING_MAX_AGE_MINUTES=30
NOTIFICATION_SLO_DELIVERY_MAX_MINUTES=15
NOTIFICATION_SLO_FAILURE_RATE_PERCENT=5
NOTIFICATION_SLO_DEAD_LETTER_ACK_MAX_HOURS=24
NOTIFICATION_DEAD_LETTER_BATCH_MAX=25
# NOTIFICATION_UNSUBSCRIBE_SECRET= # defaults to JWT_ACCESS_SECRET in dev

# Admin → custom email broadcast (segment size cap)
ADMIN_EMAIL_BROADCAST_MAX_RECIPIENTS=1000
# Optional: public base URL for email images instead of CID attachments (future)
# MAIL_PUBLIC_ASSET_BASE_URL="https://cdn.example.com"

# Google OAuth. Callback must match Google Cloud Console (e.g. http://localhost:3001/v1/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:3001/v1/auth/google/callback"

# Customer app base URL (used after customer Google sign-in and in emails)
# FRONTEND_URL="http://localhost:3002"
# CUSTOMER_APP_URL="http://localhost:3002"

# Public marketing / fundraiser site (Paystack callback for campaign orders — TTW-032)
# WEB_APP_URL="http://localhost:3000"
# Optional absolute override; supports {orderId} placeholder.
# PAYSTACK_CALLBACK_URL="https://www.example.com/orders/{orderId}/confirm"
# Comma-separated Paystack authorization URL host allowlist
# PAYSTACK_AUTHORIZATION_HOSTS="checkout.paystack.com,checkout.paystack.test"

# Public origin for design share URLs (TTW-026). Required in production.
# DESIGN_SHARE_PUBLIC_ORIGIN="http://localhost:3002"

# Admin app base URL (used after admin Google sign-in)
# ADMIN_APP_URL="http://localhost:3003"

# TTW-020 auth surface isolation: comma-separated Origin allowlists used to
# derive the request's surface (admin vs customer) and to enforce CSRF Origin
# checks. Required in production (fail-closed). Defaults when unset in
# non-production: admin=http://localhost:3003;
# customer=http://localhost:3000,http://localhost:3002
# AUTH_ADMIN_ORIGINS="http://localhost:3003"
# AUTH_CUSTOMER_ORIGINS="http://localhost:3000,http://localhost:3002"

# TTW-042 payout policy. AUTO_EXECUTE remains blocked until clean-run evidence.
# PAYOUT_AUTO_EXECUTE_ENABLED="false"
# Bank resolution: stub (non-prod default) or live (required in production).
# PAYOUT_BANK_RESOLUTION_MODE="stub"

# Server
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=info

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# S3 Storage (optional)
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000/tamiym-assets"
S3_BUCKET="tamiym-assets"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# AI Moderation (OpenAI — optional; omit to disable AI moderation and fall back to PENDING)
OPENAI_API_KEY="sk-..."
# Scores below APPROVE_THRESHOLD → APPROVED; above REJECT_THRESHOLD → REJECTED; between → FLAGGED (human queue)
MODERATION_APPROVE_THRESHOLD=0.3
MODERATION_REJECT_THRESHOLD=0.7

# Media virus scan (TTW-021). Production requires ClamAV; deterministic is forbidden in production.
# VIRUS_SCANNER=deterministic|clamav|unavailable — non-production default is deterministic
VIRUS_SCANNER="deterministic"
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT=3310
VIRUS_SCAN_TIMEOUT_MS=15000
# Optional fixture for local/tests: infected|unavailable
# VIRUS_SCAN_FIXTURE=

# Remote media import fetch limits (SSRF-safe fetcher)
MEDIA_FETCH_TIMEOUT_MS=10000
