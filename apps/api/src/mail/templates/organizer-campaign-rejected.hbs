{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Campaign needs updates</h1>
{{#if firstName}}
<p style="margin:0 0 16px 0;color:#374151;">Hi {{firstName}},</p>
{{/if}}
<p style="margin:0 0 16px 0;color:#374151;">Your campaign <strong>{{campaignTitle}}</strong> was returned for edits.</p>
<p style="margin:0 0 16px 0;color:#374151;">{{customerVisibleReason}}</p>
<p style="margin:0;color:#374151;">You can update the campaign in your dashboard and resubmit for review.</p>
{{> footer}}
