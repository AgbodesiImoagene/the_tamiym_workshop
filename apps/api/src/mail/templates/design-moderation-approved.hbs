{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Design approved</h1>
{{#if firstName}}
<p style="margin:0 0 16px 0;color:#374151;">Hi {{firstName}},</p>
{{/if}}
<p style="margin:0 0 16px 0;">Your design <strong>{{designName}}</strong> for <strong>{{productName}}</strong> has been approved and can be used for purchase.</p>
<p style="margin:0;font-family:ui-monospace,monospace;font-size:13px;color:#6b7280;">Design ID: {{designId}}</p>
{{> footer}}
