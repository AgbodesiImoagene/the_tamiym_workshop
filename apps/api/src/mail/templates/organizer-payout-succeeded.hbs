{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Payout sent</h1>
{{#if firstName}}
<p style="margin:0 0 16px 0;color:#374151;">Hi {{firstName}},</p>
{{/if}}
<p style="margin:0 0 16px 0;">A payout for your campaign <strong>{{campaignTitle}}</strong> has completed successfully.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:16px 0;background-color:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 8px 0;"><strong>Amount</strong></p>
      <p style="margin:0 0 16px 0;font-size:18px;color:#004385;">{{formatAmount amount currency}}</p>
      <p style="margin:0;font-size:13px;color:#6b7280;font-family:ui-monospace,monospace;">Payout ID: {{payoutId}}</p>
    </td>
  </tr>
</table>
<p style="margin:16px 0 0 0;font-size:14px;color:#6b7280;">Funds should appear in your bank account according to your bank's settlement times.</p>
{{> footer}}
