{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Payment confirmed</h1>
<p style="margin:0 0 16px 0;">Thank you — we have received your payment. Your order is confirmed.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:16px 0;background-color:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 8px 0;"><strong>Order</strong></p>
      <p style="margin:0 0 16px 0;font-family:ui-monospace,monospace;font-size:14px;">{{orderId}}</p>
      <p style="margin:0 0 8px 0;"><strong>Amount paid</strong></p>
      <p style="margin:0 0 16px 0;font-size:18px;color:#004385;">{{formatAmount amount currency}}</p>
      {{#if reference}}
      <p style="margin:0 0 8px 0;"><strong>Reference</strong></p>
      <p style="margin:0;font-family:ui-monospace,monospace;font-size:13px;">{{reference}}</p>
      {{/if}}
    </td>
  </tr>
</table>
<p style="margin:16px 0 0 0;font-size:14px;color:#6b7280;">We will send updates when your order ships. If you have questions, contact support through the app.</p>
{{> footer}}
