{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Refund processed</h1>
{{#if firstName}}
<p style="margin:0 0 16px 0;color:#374151;">Hi {{firstName}},</p>
{{/if}}
<p style="margin:0 0 16px 0;">We have processed a refund for your order. The amount below will be returned via your original payment method; timing depends on your bank or card issuer.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:16px 0;background-color:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 8px 0;"><strong>Order</strong></p>
      <p style="margin:0 0 16px 0;font-family:ui-monospace,monospace;font-size:14px;">{{orderId}}</p>
      <p style="margin:0 0 8px 0;"><strong>Refund amount</strong></p>
      <p style="margin:0;font-size:18px;color:#004385;">{{formatAmount amount currency}}</p>
      {{#if reason}}
      <p style="margin:16px 0 0 0;font-size:14px;color:#6b7280;"><strong>Note:</strong> {{reason}}</p>
      {{/if}}
    </td>
  </tr>
</table>
{{> footer}}
