{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">New order placed</h1>
<p style="margin:0 0 16px 0;">A customer has placed an order that is awaiting payment (or has just been created).</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:16px 0;background-color:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 8px 0;"><strong>Order ID</strong></p>
      <p style="margin:0 0 16px 0;font-family:ui-monospace,monospace;font-size:14px;">{{orderId}}</p>
      <p style="margin:0 0 8px 0;"><strong>Total</strong></p>
      <p style="margin:0;font-size:18px;color:#004385;">{{formatAmount totalAmount currency}}</p>
    </td>
  </tr>
</table>
<p style="margin:16px 0 0 0;font-size:14px;color:#6b7280;">Review this order in the admin dashboard when payment completes.</p>
{{> footer}}
