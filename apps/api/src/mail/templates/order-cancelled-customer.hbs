{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Order cancelled</h1>
{{#if firstName}}
<p style="margin:0 0 16px 0;color:#374151;">Hi {{firstName}},</p>
{{/if}}
<p style="margin:0 0 16px 0;">Your order has been cancelled. If you were not expecting this, please contact support through the app or reply to the store team.</p>
<p style="margin:0;font-family:ui-monospace,monospace;font-size:14px;color:#4b5563;">Order ID: {{orderId}}</p>
{{> footer}}
