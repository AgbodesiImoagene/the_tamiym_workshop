{{> header}}
<h1 style="margin:0 0 16px 0;font-size:22px;font-weight:600;color:#004385;">Verify your email</h1>
<p style="margin:0 0 16px 0;">Thanks for signing up. Please verify your email address using the button below.</p>
<p style="margin:24px 0;">
  <a href="{{verifyUrl}}" style="display:inline-block;background-color:#45ff70;color:#091f33;font-weight:600;text-decoration:none;padding:12px 24px;border-radius:8px;">Verify email</a>
</p>
<p style="margin:0 0 8px 0;font-size:14px;color:#4b5563;">Or copy this link into your browser:</p>
<p style="margin:0;word-break:break-all;font-size:13px;color:#1d99ff;"><a href="{{verifyUrl}}" style="color:#1d99ff;">{{verifyUrl}}</a></p>
<p style="margin:24px 0 0 0;font-size:14px;color:#6b7280;">This link expires in 24 hours. If you did not create an account, you can ignore this email.</p>
{{> footer}}
