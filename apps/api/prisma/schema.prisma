// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// NOTE: This schema is designed for:
// - NestJS + Prisma + Postgres
// - Nigeria-only v1 (currency default NGN), Paystack-only v1 (via provider interface)
// - Admin dashboard + moderation + basic analytics support
// - Structured Design Workshop (Fabric.js) storing layered design JSON + assets
//
// Conventions:
// - Use enums (not strings) for statuses/roles to prevent invalid values.
// - Orders snapshot shipping details to avoid historical drift if Address changes.
// - Payments/Refunds/Payouts modeled explicitly for auditability & idempotency.
// - Discounts + Bulk pricing supported.
//
// Missing constraints (not expressible in PSL): enforce in application logic or add via
// a separate migration. See model-level comments for details (ProductView.isDefault,
// Address.isDefault, UserPayoutProfile.isDefault, OrganizerPricingPolicy, Discount,
// BulkPricing).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * Enums
 * =========================
 */

/// Role of a user in the system (customer, organizer, or admin).
enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
}

/// Lifecycle status of a user account.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// TTW-025 data-subject request kinds.
enum PrivacyRequestType {
  EXPORT
  ERASURE
}

/// TTW-025 privacy request lifecycle.
enum PrivacyRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  HELD
}

/// External identity provider linked to a user (e.g. Google OAuth).
enum OAuthProvider {
  GOOGLE
}

/// Type of one-time or session token stored in AuthToken.
enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Auth surface a session belongs to (TTW-020). Distinguishes admin sessions
/// from customer/organizer sessions so credentials/cookies never cross boundaries.
/// Nullable until legacy (pre-TTW-020) refresh tokens are revoked or expire.
enum AuthSurface {
  CUSTOMER
  ADMIN
}

/// How a product image is used (thumbnail, gallery, or workshop template).
enum ImageRole {
  THUMBNAIL
  GALLERY
  WORKSHOP_TEMPLATE
}

/// Order lifecycle from draft/cart through payment, fulfillment, and delivery or refund.
enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  DELIVERED
  CANCELLED
  /// Provider-confirmed refunds cover some but not all of the captured value (TTW-013).
  PARTIALLY_REFUNDED
  /// Provider-confirmed refunds cover the full captured value (TTW-013).
  REFUNDED
}

/// Status of a payment attempt for an order.
enum PaymentStatus {
  PENDING
  INITIATED
  SUCCEEDED
  FAILED
}

/// Lifecycle status of a fundraising campaign.
/// DRAFT: organiser editing; REVIEW: submitted for admin review; ACTIVE: live and accepting orders;
/// PAUSED: temporarily stopped by organiser; DISABLED: admin-forced off; ENDED: past end date or closed.
enum CampaignStatus {
  DRAFT
  REVIEW
  ACTIVE
  PAUSED
  DISABLED
  ENDED
}

/// Moderation outcome for a design or asset (e.g. user-uploaded art).
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

/// Polymorphic subject for an immutable moderation decision (TTW-027).
enum ModerationSubjectType {
  DESIGN
  MEDIA
  CAMPAIGN
}

/// Who produced a moderation decision.
enum ModerationActorKind {
  AI
  ADMIN
  SYSTEM
  APPEAL_RESOLUTION
}

/// Owner appeal lifecycle for a challenged moderation decision.
enum ModerationAppealStatus {
  PENDING
  WITHDRAWN
  UPHELD
  OVERTURNED
  ESCALATED
}

/// TTW-030 organiser onboarding application lifecycle.
enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}


/// Lifecycle status for a media asset ingestion job.
enum MediaAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Where a media asset originated from.
enum MediaSourceType {
  UPLOAD
  IMPORT_URL
}

/// Derivative type for a media asset.
enum MediaDerivativeType {
  ORIGINAL
  DISPLAY
  THUMB
}

/// Virus scan status for media assets.
enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// Payment or payout provider (v1: Paystack only).
enum PaymentProvider {
  PAYSTACK
  // Future: STRIPE, FLUTTERWAVE, PAYPAL
}

/// How a discount value is applied (percentage, fixed amount, or bulk tier).
enum DiscountType {
  PERCENTAGE
  FIXED
  BULK
}

/// Scope of a discount (order, product, variant, or campaign).
enum DiscountScope {
  ORDER
  PRODUCT
  VARIANT
  CAMPAIGN
}

/// Whether a discount is currently active or inactive.
enum DiscountStatus {
  ACTIVE
  INACTIVE
}

/// Visibility/lifecycle status of a product in the catalog.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Supported currency (v1: NGN only).
enum CurrencyCode {
  NGN
  // Future: USD, EUR, GBP, etc.
}

/// Where an address was sourced from before normalization.
enum AddressProvider {
  MANUAL
  GOOGLE_PLACES
  OTHER
}

/// Generic strategy used to match an address or destination to a shipping zone.
enum ShippingRuleMatchType {
  ADMIN1
  ADMIN2
  CITY
  POSTAL_CODE
  POSTAL_PREFIX
}

/// Provider used to quote a shipping rate.
enum ShippingRateProvider {
  INTERNAL
}

/// Channel used to send a notification (email, SMS, or Slack).
enum NotificationChannel {
  EMAIL
  SMS
  SLACK
}

/// Delivery status of a notification outbox item.
enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Type of admin or system action recorded in the audit log.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  FLAG
  DISABLE
  ENABLE
  STATUS_CHANGE
  REFUND
  PAYOUT
}

/// Result of a security-sensitive or administrative action.
enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Origin of an audit event.
enum AuditSource {
  PUBLIC_API
  ADMIN_API
  WEBHOOK
  WORKER
  CRON
  SYSTEM
}

/// Status of a payout to an organizer or recipient.
enum PayoutStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUEUED
  PROCESSING
  INITIATED
  SUCCEEDED
  FAILED
  REVERSED
  CANCELLED
}

/// Type of entry in the campaign balance ledger (source of truth for eligible payout).
enum LedgerEntryType {
  PAYMENT_SETTLED
  REFUND_APPLIED
  PAYOUT_RESERVED
  PAYOUT_SUCCEEDED
  PAYOUT_FAILED
  MANUAL_ADJUSTMENT
}

/// Payout automation mode: manual-only, batch with approval, or fully automatic.
enum PayoutMode {
  MANUAL
  AUTO_APPROVAL_REQUIRED
  AUTO_EXECUTE
}

/// Status of a payout run (batch).
enum PayoutRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  COMPLETED
  CANCELLED
}

/// Lifecycle of a provider refund attempt (TTW-013).
/// Financial/campaign/ledger effects apply only on SUCCEEDED after provider confirmation.
enum RefundStatus {
  /// Reserved locally before/while calling the provider; counts toward the in-flight cap.
  INITIATED
  /// Provider accepted the refund and is processing (refund.pending / refund.processing).
  PROCESSING
  /// Provider requires bank details (refund.needs-attention); still in-flight for the cap.
  NEEDS_ATTENTION
  /// Provider-confirmed success (refund.processed); settlement claim applied exactly once.
  SUCCEEDED
  /// Provider-confirmed failure (refund.failed) or hard initiation rejection.
  FAILED
}

/// Auditable inventory counter effect (TTW-014). Each tracked order line follows reserve→release or reserve→consume exactly once.
enum InventoryMovementKind {
  RESERVE
  RELEASE
  CONSUME
}

/// Provenance of OrderItem customer-visible display snapshots (TTW-033).
/// PURCHASE = written at order creation; BACKFILLED_CURRENT_CATALOG = migrated from
/// catalogue at backfill time (not historical evidence of what the buyer saw).
enum OrderItemSnapshotSource {
  PURCHASE
  BACKFILLED_CURRENT_CATALOG
}

/// Type of layer in a workshop template (base, mask, outline, etc.).
enum TemplateLayerType {
  BASE
  SHADOW
  HIGHLIGHT
  MASK_OVERLAY
  OUTLINE
  DETAIL
}

/// Effect applied to a template layer when an option value is selected (e.g. TINT, REPLACE_IMAGE).
enum TemplateEffectType {
  TINT // apply color to a mask layer
  SHOW // show a layer (opacity->1)
  HIDE // hide a layer (opacity->0)
  REPLACE_IMAGE // swap layer image based on value
}

/// Blend mode for rendering a template layer over the product image.
enum BlendMode {
  NORMAL
  MULTIPLY
  SCREEN
  OVERLAY
  DARKEN
  LIGHTEN
}

/// TTW-015 reconciliation run kind.
enum ReconciliationRunKind {
  INTERNAL
  PROVIDER
  TARGETED
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  INCOMPLETE
  FAILED
}

enum ReconciliationDomain {
  PAYMENT
  REFUND
  PAYOUT
  CAMPAIGN
  INVENTORY
}

enum ReconciliationOutcome {
  MATCHED
  MISMATCH
  MISSING_INTERNAL
  MISSING_PROVIDER
  PENDING_GRACE
  UNVERIFIABLE
}

enum ReconciliationFindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WONT_FIX
}

enum ReconciliationSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReconciliationRepairStatus {
  REQUESTED
  APPROVED
  APPLIED
  FAILED
  CANCELLED
}

/**
 * =========================
 * Core Users & Addresses
 * =========================
 */

/// Authenticated user (customer, organizer, or admin). Holds auth, profile, and relations.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Null when the user only signs in via OAuth (e.g. Google).
  passwordHash String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  firstName       String
  lastName        String
  phone           String? // not unique by default; can be unique if you enforce it
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               Order[]
  addresses            Address[]
  campaigns            Campaign[]           @relation("OrganizerCampaigns")
  designs              Design[]
  designAssets         DesignAsset[]
  payouts              Payout[]             @relation("RecipientPayouts")
  payoutRunsRequested  PayoutRun[]          @relation("PayoutRunRequestedBy")
  payoutRunsApproved   PayoutRun[]          @relation("PayoutRunApprovedBy")
  auditLogs            AuditLog[]           @relation("ActorAuditLogs")
  payoutProfiles       UserPayoutProfile[]
  notificationOutboxes NotificationOutbox[]
  authTokens           AuthToken[]
  authSessions         AuthSession[]
  oauthAccounts        UserOAuthAccount[]
  adminMfaCredential   AdminMfaCredential?
  privacyRequests      PrivacyRequest[]
  organizerApplications OrganizerApplication[] @relation("OrganizerApplicationApplicant")
  organizerApplicationsReviewed OrganizerApplication[] @relation("OrganizerApplicationReviewer")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Linked OAuth provider account (one Google account ↔ one user).
model UserOAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String /// Provider stable user id (e.g. Google sub)
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_oauth_accounts")
}

/// Centralised one-time auth tokens: password reset, email verification.
/// Refresh credentials live in AuthSession (hashed) — TTW-023.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  tokenType TokenType

  /// Legacy surface column from TTW-020 refresh rows. Null for RESET/VERIFY.
  /// Refresh sessions moved to AuthSession; do not write REFRESH here.
  authSurface AuthSurface?

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([tokenType])
  @@index([expiresAt])
  @@index([authSurface])
  @@map("auth_tokens")
}

/// Audience-bound, rotating refresh session (TTW-023). Refresh plaintext is
/// never stored — only sha256(refreshToken). Access JWTs carry `sid`.
model AuthSession {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSurface      AuthSurface
  refreshTokenHash String      @unique
  /// Optional coarse device label from User-Agent (never a fingerprint).
  deviceLabel      String?
  createdAt        DateTime    @default(now())
  lastSeenAt       DateTime    @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId, authSurface])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// ADMIN-only TOTP credential (TTW-023). Secrets are AES-256-GCM ciphertext;
/// plaintext never persisted. `enabledAt` null means enrollment incomplete.
model AdminMfaCredential {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Active TOTP secret (base64 AES-GCM ciphertext). Null until enrollment confirms.
  secretCiphertext String?
  /// 12-byte nonce for `secretCiphertext` (base64).
  secretNonce      String?
  /// Encryption key version used for the active secret (rotation support).
  keyVersion       Int     @default(1)
  enabledAt        DateTime?

  /// Pending enrollment secret (base64 AES-GCM ciphertext) before confirm.
  pendingSecretCiphertext String?
  pendingNonce            String?
  pendingKeyVersion       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recoveryCodes AdminMfaRecoveryCode[]

  @@map("admin_mfa_credentials")
}

/// One-time ADMIN MFA recovery codes. Only sha256(code) is stored.
model AdminMfaRecoveryCode {
  id     String @id @default(cuid())
  userId String

  credential AdminMfaCredential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("admin_mfa_recovery_codes")
}

/// Shipping or billing address for a user. Used at checkout and snapshotted on Order.
/// Missing constraint: at most one address per user may have isDefault = true. Enforce in app when setting default, or add migration: CREATE UNIQUE INDEX addresses_one_default_per_user ON addresses (user_id) WHERE is_default = true;
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientName String?
  phone         String?

  addressLine1             String
  addressLine2             String?
  city                     String
  state                    String
  postalCode               String?
  country                  String  @default("Nigeria")
  countryCode              String  @default("NG")
  landmark                 String?
  instructions             String?
  locality                 String?
  dependentLocality        String?
  administrativeAreaLevel1 String?
  administrativeAreaLevel2 String?

  /// Normalized state code (e.g. LA, AB) for shipping zones. Required for checkout when using zone-based shipping.
  stateCode String?
  geoState  GeoState? @relation("AddressStateCode", fields: [stateCode], references: [code], onDelete: SetNull)
  /// LGA for zone-based shipping (optional in v1).
  lgaId     String?
  lga       GeoLga?   @relation(fields: [lgaId], references: [id], onDelete: SetNull)

  /// Optional Google Places fields for autocomplete UX.
  provider              AddressProvider @default(MANUAL)
  googlePlaceId         String?
  formattedAddress      String?
  latitude              Decimal?        @db.Decimal(10, 7)
  longitude             Decimal?        @db.Decimal(10, 7)
  normalizationMetadata Json?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([stateCode])
  @@index([lgaId])
  @@map("addresses")
}

/**
 * =========================
 * Site-wide settings (singleton)
 * =========================
 */

/// Single-row site config for VAT, default currency, and payout policy. Application must ensure only one row exists.
model SiteSettings {
  id String @id @default("default")

  vatRate              Decimal      @db.Decimal(5, 4) // e.g. 0.075 for 7.5%
  pricesIncludeVat     Boolean      @default(true)
  vatAppliesToShipping Boolean      @default(true)
  currency             CurrencyCode @default(NGN)

  /// Payout policy (fundraiser organizer payouts).
  payoutMode               PayoutMode @default(MANUAL)
  payoutCadenceDays        Int        @default(7) /// e.g. 7 = weekly.
  payoutSettlementHoldDays Int        @default(7)
  minimumPayoutAmount      Decimal?   @db.Decimal(10, 2)
  autoRetryFailedPayouts   Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/**
 * =========================
 * Shipping: Geo (Nigeria) + Zones + Rates
 * =========================
 */

/// Nigerian state (or territory). Used for shipping zones and address normalization.
model GeoState {
  code     String  @id // e.g. LA, AB
  name     String
  isActive Boolean @default(true)

  lgas                 GeoLga[]
  shippingAreas        ShippingZoneArea[]
  addressesByStateCode Address[]          @relation("AddressStateCode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("geo_states")
}

/// Local Government Area within a state. Optional for zone-based shipping in v1.
model GeoLga {
  id        String   @id @default(cuid())
  stateCode String
  state     GeoState @relation(fields: [stateCode], references: [code], onDelete: Cascade)
  code      String? // optional LGA code
  name      String
  isActive  Boolean  @default(true)

  addresses     Address[]
  shippingAreas ShippingZoneArea[]

  @@unique([stateCode, name])
  @@index([stateCode])
  @@map("geo_lgas")
}

/// Shipping zone (e.g. "Lagos", "Rest of Nigeria"). Areas link states/LGAs to zones.
model ShippingZone {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  areas ShippingZoneArea[]
  rules ShippingZoneRule[]
  rates ShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_zones")
}

/// Links a zone to a state (and optionally a specific LGA). Used to determine which zone an address belongs to.
model ShippingZoneArea {
  id        String       @id @default(cuid())
  zoneId    String
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  stateCode String
  state     GeoState     @relation(fields: [stateCode], references: [code], onDelete: Cascade)
  lgaId     String?
  lga       GeoLga?      @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stateCode, lgaId])
  @@index([zoneId])
  @@index([stateCode])
  @@map("shipping_zone_areas")
}

/// Generic destination rule that maps a country-specific match value to a shipping zone.
model ShippingZoneRule {
  id String @id @default(cuid())

  zoneId String
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  countryCode  String
  matchType    ShippingRuleMatchType
  /// Canonical value for the match type. Example: state code for ADMIN1, LGA id for ADMIN2.
  matchValue   String
  /// Optional context that disambiguates the match value. Example: parent ADMIN1 code for ADMIN2.
  matchContext String?
  priority     Int                   @default(100)
  isActive     Boolean               @default(true)
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, countryCode, matchType, matchValue, matchContext])
  @@index([zoneId])
  @@index([countryCode, matchType, priority, isActive])
  @@map("shipping_zone_rules")
}

/// Flat fee (or future: rate table) for a zone. Optional effective dates for v1.
model ShippingRate {
  id              String               @id @default(cuid())
  zoneId          String
  zone            ShippingZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  provider        ShippingRateProvider @default(INTERNAL)
  serviceLevel    String               @default("STANDARD")
  currency        CurrencyCode         @default(NGN)
  flatFee         Decimal              @db.Decimal(10, 2)
  priority        Int                  @default(100)
  isActive        Boolean              @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  minDeliveryDays Int?
  maxDeliveryDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([zoneId, currency, isActive, priority])
  @@map("shipping_rates")
}

/**
 * =========================
 * Catalog: Categories, Products, Variants, Options
 * =========================
 */

/// Product category (e.g. T‑shirts, Mugs). Used for catalog grouping and filtering.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

/// Sellable product in the catalog. Has views, options, prices, and design templates.
model Product {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name            String
  slug            String        @unique
  description     String?
  status          ProductStatus @default(DRAFT)
  weightGrams     Int?
  packageLengthMm Int?
  packageWidthMm  Int?
  packageHeightMm Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants                   ProductVariant[]
  options                    ProductOption[]
  images                     ProductImage[]
  views                      ProductView[]
  printAreas                 PrintArea[]
  prices                     ProductPrice[]
  bulkPricingTiers           BulkPricing[]
  orderItems                 OrderItem[]
  campaignProducts           CampaignProduct[]
  designs                    Design[]
  discountProducts           DiscountProduct[]
  productImageRoles          ProductImageRole[]
  productViewPricings        ProductViewPricing[]
  workshopTemplateLayers     WorkshopTemplateLayer[]
  optionValueTemplateEffects OptionValueTemplateEffect[]
  organizerPricingPolicies   OrganizerPricingPolicy[]

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

/// Option definition for a product (e.g. size, color). Contains a set of ProductOptionValues.
model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  code      String // e.g. "size", "color", "fit", "material"
  name      String
  sortOrder Int    @default(0)

  values              ProductOptionValue[]
  variantOptionValues VariantOptionValue[]
  templateEffects     OptionValueTemplateEffect[]

  @@unique([productId, code])
  @@index([productId])
  @@map("product_options")
}

/// A single value for an option (e.g. "L", "BLACK"). Linked to variants via VariantOptionValue.
model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  valueCode   String // e.g. "L", "BLACK", "UNISEX"
  displayName String
  metadata    Json? // e.g. { "hex": "#000000" }
  sortOrder   Int    @default(0)

  variantLinks    VariantOptionValue[]
  templateEffects OptionValueTemplateEffect[]
  upcharges       OptionValueUpcharge[]

  @@unique([optionId, valueCode])
  @@index([optionId])
  @@map("product_option_values")
}

/// Optional additive upcharge for an option value (e.g. size XL +50). Applied in standard checkout; configurable for campaign buyer pricing.
model OptionValueUpcharge {
  id            String             @id @default(cuid())
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  currency      CurrencyCode       @default(NGN)
  amount        Decimal            @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionValueId, currency])
  @@index([optionValueId])
  @@map("option_value_upcharges")
}

/// Concrete variant of a product (e.g. Small/Red). Has SKU, inventory, and prices (VariantPrice).
/// Option values (size, color, etc.) are in VariantOptionValue -> ProductOptionValue; name is the display label.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String // e.g., "Small / Red / Unisex" (derived from option values at creation)
  sku  String @unique

  isAvailable     Boolean @default(true)
  weightGrams     Int?
  packageLengthMm Int?
  packageWidthMm  Int?
  packageHeightMm Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  optionValues VariantOptionValue[]
  inventory    InventoryItem?
  movements    InventoryMovement[]
  prices       VariantPrice[]
  bulkPricing  BulkPricing[]

  orderItems       OrderItem[]
  discountVariants DiscountVariant[]

  images                   ProductImage[]
  productViewPricings      ProductViewPricing[]
  organizerPricingPolicies OrganizerPricingPolicy[]

  @@index([productId])
  @@map("product_variants")
}

/// Join table linking a variant to the option values that define it (e.g. size=L, color=BLACK).
model VariantOptionValue {
  variantId     String
  optionId      String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@unique([variantId, optionId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

/// Stock and reservation for a single variant. One-to-one with ProductVariant.
model InventoryItem {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  stockOnHand       Int     @default(0)
  reserved          Int     @default(0)
  trackInventory    Boolean @default(true)
  lowStockThreshold Int     @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("inventory_items")
}

/// Append-only inventory effect keyed for exactly-once reserve/release/consume (TTW-014).
model InventoryMovement {
  id   String                @id @default(cuid())
  kind InventoryMovementKind

  /// Business effect key, e.g. `inventory.reserve:orderItem:{id}`.
  effectKey String @unique

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  quantity         Int
  reservedDelta    Int @default(0)
  stockOnHandDelta Int @default(0)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([kind, createdAt])
  @@map("inventory_movements")
}

/// Base price for a product per currency. One row per (product, currency).
model ProductPrice {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  currency  CurrencyCode @default(NGN)
  amount    Decimal      @db.Decimal(10, 2)
  compareAt Decimal?     @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, currency])
  @@index([productId])
  @@index([currency])
  @@map("product_prices")
}

/// Price for a variant per currency. Overrides or supplements product base price.
model VariantPrice {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  currency  CurrencyCode @default(NGN)
  amount    Decimal      @db.Decimal(10, 2)
  compareAt Decimal?     @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, currency])
  @@index([variantId])
  @@index([currency])
  @@map("variant_prices")
}

/// Campaign-specific selling price for a campaign product per currency.
model CampaignProductPrice {
  id                String          @id @default(cuid())
  campaignProductId String
  campaignProduct   CampaignProduct @relation(fields: [campaignProductId], references: [id], onDelete: Cascade)

  currency  CurrencyCode @default(NGN)
  amount    Decimal      @db.Decimal(10, 2)
  compareAt Decimal?     @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignProductId, currency])
  @@index([campaignProductId])
  @@index([currency])
  @@map("campaign_product_prices")
}

/// Image asset for a product (or optionally a variant). Used in gallery, thumbnails, and workshop templates.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  sortOrder Int     @default(0)
  altText   String?

  createdAt DateTime @default(now())

  roles              ProductImageRole[]
  templateLayers     WorkshopTemplateLayer[]
  replacementEffects OptionValueTemplateEffect[] @relation("ReplacementImageEffects")

  @@index([productId])
  @@index([variantId])
  @@index([mediaAssetId])
  @@map("product_images")
}

/// Assigns an image to a role (thumbnail, gallery, or workshop template) for a product or product view.
model ProductImageRole {
  id String @id @default(cuid())

  // Include productId to enforce product-scoped uniqueness constraints.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  role      ImageRole
  sortOrder Int? // used for GALLERY ordering; optional for others

  // Only applicable for WORKSHOP_TEMPLATE (template per view)
  productViewId String?
  productView   ProductView? @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, role, productViewId])
  @@index([productId])
  @@index([imageId])
  @@index([productViewId])
  @@map("product_image_roles")
}

/// A designable view of a product (e.g. front, back, sleeve). Has print area, pricing, and template layers.
/// Missing constraint: at most one view per product may have isDefault = true. Enforce in app when setting default, or add migration: CREATE UNIQUE INDEX product_views_one_default_per_product ON product_views (product_id) WHERE is_default = true;
model ProductView {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  key         String // e.g. "front", "back", "mug_wrap"
  displayName String // e.g. "Front", "Back", "Wrap"
  sortOrder   Int    @default(0)

  isDesignable Boolean @default(true)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printAreas      PrintArea[]
  imageRoles      ProductImageRole[]
  designViews     DesignView[]
  pricingRules    ProductViewPricing[]
  templateLayers  WorkshopTemplateLayer[]
  templateEffects OptionValueTemplateEffect[]

  @@unique([productId, key])
  @@index([productId])
  @@map("product_views")
}

/// Surcharge for using an extra product view (e.g. back print). Optional variant override.
model ProductViewPricing {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Optional variant override (if some blanks cost more for extra placements)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productViewId String
  productView   ProductView @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  currency        CurrencyCode @default(NGN)
  surchargeAmount Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, variantId, productViewId, currency])
  @@index([productId])
  @@index([variantId])
  @@index([productViewId])
  @@map("product_view_pricing")
}

/**
 * =========================
 * Customization constraints (Design Workshop)
 * =========================
 */

/// Printable bounding box for a product view. Coordinates can be normalized [0..1] or px.
model PrintArea {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productViewId String
  productView   ProductView @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  // Coordinates can be normalized [0..1] or px relative to a known template.
  x      Float
  y      Float
  width  Float
  height Float

  rotationAllowed Boolean @default(false)
  maxLayers       Int? // optional
  maxColors       Int? // optional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, productViewId])
  @@index([productId])
  @@index([productViewId])
  @@map("print_areas")
}

/// A layer in the workshop template for a product view (base, mask, etc.). Drives option-based effects.
model WorkshopTemplateLayer {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productViewId String
  productView   ProductView @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  // Logical identifier like "base", "body_mask", "sleeve_mask"
  key         String
  displayName String?

  layerType TemplateLayerType

  // The image asset for this layer (PNG/WebP)
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // Rendering metadata
  blendMode BlendMode @default(NORMAL)
  opacity   Float     @default(1.0)
  zIndex    Int       @default(0)

  // Optional: extra rendering hints (e.g., transforms: offsets, scaling rules, ...)
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  effects OptionValueTemplateEffect[]

  @@unique([productViewId, key])
  @@index([productId])
  @@index([productViewId])
  @@index([imageId])
  @@map("workshop_template_layers")
}

/// Effect applied to a template layer when an option value is selected (e.g. TINT for color, REPLACE_IMAGE).
model OptionValueTemplateEffect {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productViewId String
  productView   ProductView @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  templateLayerId String
  templateLayer   WorkshopTemplateLayer @relation(fields: [templateLayerId], references: [id], onDelete: Cascade)

  effectType TemplateEffectType

  // For TINT: either pull from optionValue.metadata.hex or override here
  tintHex String?

  // For REPLACE_IMAGE: optional override image
  replacementImageId String?
  replacementImage   ProductImage? @relation("ReplacementImageEffects", fields: [replacementImageId], references: [id], onDelete: SetNull)

  // Extra params if needed (e.g. opacity override)
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate effect rules for same combination
  @@unique([productViewId, optionValueId, templateLayerId, effectType])
  @@index([productId])
  @@index([productViewId])
  @@index([optionId])
  @@index([optionValueId])
  @@index([templateLayerId])
  @@map("option_value_template_effects")
}

/**
 * =========================
 * Designs & Assets
 * =========================
 */

/// User-created design for a product. Stores structured designData (layers per view) and moderation status.
model Design {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  name             String
  designData       Json // structured layer model per view
  thumbnailUrl     String?
  moderationStatus ModerationStatus @default(PENDING)
  /// AI moderation notes (internal only): category scores and reasoning from the AI pre-screen.
  moderationNotes  String?

  /// Short token for read-only public share links. Null until the user generates a share link.
  shareToken          String?   @unique
  /// Optional expiry for share tokens. Null = non-expiring.
  shareTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views DesignView[]
  shareLinks DesignShareLink[]

  orderItems       OrderItem[]
  campaignProducts CampaignProduct[]

  @@index([userId])
  @@index([productId])
  @@index([campaignId])
  @@index([moderationStatus])
  @@index([createdAt])
  @@map("designs")
}

/**
 * Digested bearer token for anonymous read-only design shares (TTW-026).
 * Plaintext is returned once at creation and never stored.
 */
model DesignShareLink {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the bearer token (unique lookup key).
  tokenHash String @unique

  /// Policy document version applied when the link was created.
  policyVersion String

  expiresAt     DateTime
  revokedAt     DateTime?
  lastAccessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([designId, createdAt])
  @@index([expiresAt])
  @@map("design_share_links")
}

/// Uploaded asset (image/file) owned by a user. Referenced from design layers.
model DesignAsset {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([ownerUserId])
  @@index([mediaAssetId])
  @@map("design_assets")
}

/// Centralized media asset with derivatives (original, display, thumb).
model MediaAsset {
  id               String           @id @default(cuid())
  sourceType       MediaSourceType
  sourceUrl        String?
  status           MediaAssetStatus @default(PENDING)
  scanStatus       VirusScanStatus  @default(PENDING)
  moderationStatus ModerationStatus @default(PENDING)
  /// AI moderation notes (internal only): category scores and reasoning from the AI pre-screen.
  moderationNotes  String?

  originalKey    String?
  originalUrl    String?
  originalMime   String?
  originalBytes  Int?
  originalWidth  Int?
  originalHeight Int?
  checksum       String?
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  derivatives   MediaDerivative[]
  productImages ProductImage[]
  designAssets  DesignAsset[]

  @@index([status])
  @@index([scanStatus])
  @@index([moderationStatus])
  @@map("media_assets")
}

/**
 * Immutable moderation decision for a design, media asset, or campaign (TTW-027).
 * Current Design/MediaAsset/Campaign moderation fields are projections of the latest row.
 * No FK to subject tables — polymorphic subjectId.
 */
model ModerationDecision {
  id           String                @id @default(cuid())
  subjectType  ModerationSubjectType
  subjectId    String
  /// Optional content fingerprint (sha256 hex) of the moderated revision.
  revisionHash String?

  outcome ModerationStatus

  actorKind   ModerationActorKind
  actorUserId String?

  policyVersion String
  modelVersion  String?

  reasonCodes String[]

  /// Customer-safe explanation only (never AI scores or internal notes).
  customerExplanation String?
  /// Internal evidence (scores, notes); admin-only in APIs.
  internalEvidence    Json?

  /// Prior decision this row supersedes (appeal resolution / resubmit), if any.
  supersedesDecisionId String?

  createdAt DateTime @default(now())

  appeals ModerationAppeal[]

  @@index([subjectType, subjectId, createdAt])
  @@map("moderation_decisions")
}

/**
 * Owner appeal against an eligible moderation decision (TTW-027).
 * At most one PENDING appeal per decision (partial unique index in migration).
 */
model ModerationAppeal {
  id         String             @id @default(cuid())
  decisionId String
  decision   ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  ownerUserId String
  status      ModerationAppealStatus @default(PENDING)

  statement     String
  policyVersion String

  /// Decision appended when the appeal was resolved (UPHELD / OVERTURNED).
  resolutionDecisionId String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  withdrawnAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, status])
  @@index([decisionId])
  @@index([status, createdAt])
  @@map("moderation_appeals")
}

/// TTW-030: admin-reviewed organiser onboarding application (immutable terminal decisions).
/// Organiser onboarding applications (TTW-030).
/// SQL partial unique index `organizer_applications_one_pending_per_user`
/// enforces at most one PENDING row per userId (see migration); Prisma cannot
/// express partial unique indexes in schema, so the constraint lives in SQL.
model OrganizerApplication {
  id     String                     @id @default(cuid())
  userId String
  user   User                       @relation("OrganizerApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)

  organisationName String
  intendedUse      String
  termsVersion     String
  termsAcceptedAt  DateTime

  status OrganizerApplicationStatus @default(PENDING)

  reviewedByUserId String?
  reviewedBy       User?    @relation("OrganizerApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  /// Customer-safe rejection / decision copy only (never internal notes).
  customerVisibleReason String?
  /// Admin-only notes; never returned on customer endpoints.
  internalNotes         String?

  policyVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("organizer_applications")
}


/// Media derivatives for an asset (original, display, thumb).
model MediaDerivative {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  type      MediaDerivativeType
  key       String
  url       String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?

  createdAt DateTime @default(now())

  @@unique([assetId, type])
  @@index([assetId])
  @@map("media_derivatives")
}

/// Per-view metadata for a design (which product view, whether used, layer count). Links Design to ProductView.
model DesignView {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  productViewId String
  productView   ProductView @relation(fields: [productViewId], references: [id], onDelete: Cascade)

  isUsed     Boolean @default(false)
  layerCount Int     @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([designId, productViewId])
  @@index([designId])
  @@index([productViewId])
  @@map("design_views")
}

/**
 * =========================
 * Orders, Payments, Refunds
 * =========================
 */

/// Customer order. Snapshot of shipping address; status and payment status; line items and payments.
model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Reference to address used, but ALSO store snapshot below.
  shippingAddressId String
  shippingAddress   Address @relation(fields: [shippingAddressId], references: [id])

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)

  currency CurrencyCode @default(NGN)

  /// Merchandise total before discounts. Invariant with discountAmount and line totals.
  subtotalAmount Decimal @db.Decimal(10, 2)
  shippingFee    Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  /// VAT component from the quote (null on legacy orders created before TTW-024).
  vatAmount Decimal? @db.Decimal(10, 2)
  /// Display-granularity delta: totalAmount - (subtotal - discount + shipping [+ vat if exclusive]).
  roundingAdjustment Decimal? @db.Decimal(10, 2)
  /// Snapshot of SiteSettings.vatRate at order time (null = unreproducible legacy).
  vatRateSnapshot Decimal? @db.Decimal(5, 4)
  pricesIncludeVatSnapshot     Boolean?
  vatAppliesToShippingSnapshot Boolean?
  /// e.g. ngn-v1-interim-2026-08; null on unreproducible legacy rows.
  pricingPolicyVersion String?
  totalAmount Decimal @db.Decimal(10, 2)

  // Shipping snapshot (prevents drift if Address changes later)
  shipRecipientName String?
  shipPhone         String?
  shipLine1         String
  shipLine2         String?
  shipCity          String
  shipState         String
  shipPostalCode    String?
  shipCountry       String  @default("Nigeria")
  shipLandmark      String?
  shipInstructions  String?

  // Paystack reference for the order-level payment attempt (still track Payment rows below)
  paymentReference String? @unique

  /// When set, this order is a campaign order (all items from this campaign). Enforces single-campaign-per-order.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Snapshot of shipping zone/rate applied at order time, e.g. { zoneId, rateId, appliedFee, vatAppliedToShipping }.
  shippingBreakdown Json?

  /// Unpaid orders expire and release inventory; set when status is PENDING_PAYMENT.
  expiresAt   DateTime?
  cancelledAt DateTime?

  /// Idempotency key (per user) to avoid duplicate orders on retries.
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payments       Payment[]
  refunds        Refund[]
  orderDiscounts OrderDiscount[]
  inventoryMovements InventoryMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([campaignId])
  @@map("orders")
}

/// Single line item on an order (product, variant, optional design/campaign). Stores unit pricing and optional breakdown.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  designId String?
  design   Design? @relation(fields: [designId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  quantity Int

  unitBasePrice      Decimal @db.Decimal(10, 2) // base includes 1 view
  unitViewSurcharge  Decimal @default(0) @db.Decimal(10, 2)
  unitDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  unitFinalPrice     Decimal @db.Decimal(10, 2) // base + surcharge - discount

  /// Snapshot of variant option values at time of order, e.g.
  /// [{ "option": "Size", "optionCode": "size", "value": "Large", "valueCode": "L" }]
  variantSnapshot Json?

  /// Customer-visible product name at purchase (or backfill). Immutable after write.
  productNameSnapshot String
  /// Customer-visible variant label (name + SKU) at purchase (or backfill).
  variantDisplaySnapshot String
  /// Customer-visible option presentation at purchase (or backfill). Same shape as variantSnapshot.
  optionPresentationSnapshot Json?
  /// Whether this display snapshot was captured at purchase or backfilled from catalogue.
  snapshotSource OrderItemSnapshotSource
  /// Display-snapshot schema version (see ORDER_ITEM_DISPLAY_SNAPSHOT_VERSION).
  snapshotVersion Int @default(1)

  pricingBreakdown         Json?
  organizerDiscountApplied Decimal? @db.Decimal(10, 2) // y (resolved) for audit, optional
  organizerCostBasis       Decimal? @db.Decimal(10, 2) // (x - y), optional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]

  @@index([orderId])
  @@index([variantId])
  @@index([campaignId])
  @@index([snapshotSource])
  @@map("order_items")
}

/// Payment attempt for an order. Tracks provider, amount, idempotency key for webhooks.
/// TTW-012: at most one active (PENDING|INITIATED) attempt per order (partial unique index).
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider    PaymentProvider @default(PAYSTACK)
  providerRef String? // Paystack transaction reference / id
  status      PaymentStatus   @default(PENDING)

  currency CurrencyCode @default(NGN)
  amount   Decimal      @db.Decimal(10, 2)

  // Idempotency: store webhook event ids if Paystack provides, else store signature hash.
  // Initiation sets this to the provider reference; settlement uses ChargeSettlementClaim.
  idempotencyKey String? @unique

  /// Paystack checkout URL returned by transaction/initialize (TTW-012 reuse).
  authorizationUrl String?
  /// Paystack access_code for the same session (TTW-012 reuse).
  accessCode       String?
  /// When this active attempt stops being reusable and may be failed (TTW-012).
  expiresAt        DateTime?

  rawEvent Json? // optional: store webhook payload (careful with size)

  /// Exactly-once settlement claim for charge.success (TTW-010).
  settlementClaim ChargeSettlementClaim?

  /// Refunds targeting this succeeded payment (TTW-013).
  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([createdAt])
  @@index([provider, providerRef])
  @@index([expiresAt])
  @@map("payments")
}

/// Exactly-once claim that a provider charge reference has settled a payment (TTW-010).
/// Inserting this row is the settlement lock; duplicates become successful no-ops.
model ChargeSettlementClaim {
  id          String          @id @default(cuid())
  provider    PaymentProvider @default(PAYSTACK)
  /// Business key, e.g. `charge.success:{providerRef}`.
  businessKey String
  paymentId   String          @unique
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId     String

  createdAt DateTime @default(now())

  @@unique([provider, businessKey])
  @@index([orderId])
  @@map("charge_settlement_claims")
}

/// Refund against an order. Tracks provider lifecycle; money moves only on SUCCEEDED (TTW-013).
model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Succeeded payment this refund targets (captured value authority).
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  provider PaymentProvider @default(PAYSTACK)
  /// Paystack refund id (numeric) once known; used for webhook matching and claim keys.
  providerRef String?
  /// Original charge/transaction reference used when creating the refund.
  transactionReference String?
  status               RefundStatus @default(INITIATED)

  currency CurrencyCode @default(NGN)
  amount   Decimal      @db.Decimal(10, 2)

  reason String?

  /// Client/admin idempotency key so retries do not create a second in-flight refund.
  idempotencyKey String? @unique

  /// Exactly-once settlement claim for refund.processed (TTW-013).
  settlementClaim RefundSettlementClaim?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([provider, providerRef])
  @@index([transactionReference])
  @@index([status])
  @@map("refunds")
}

/// Exactly-once claim that a provider refund reference has settled financial effects (TTW-013).
/// Inserting this row is the settlement lock; duplicates become successful no-ops.
model RefundSettlementClaim {
  id          String          @id @default(cuid())
  provider    PaymentProvider @default(PAYSTACK)
  /// Business key, e.g. `refund.processed:{providerRef}`.
  businessKey String
  refundId    String          @unique
  refund      Refund          @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderId     String

  createdAt DateTime @default(now())

  @@unique([provider, businessKey])
  @@index([orderId])
  @@map("refund_settlement_claims")
}

/**
 * =========================
 * Campaigns (Fundraising)
 * =========================
 */

/// Fundraising campaign. Organizer, goal, dates, optional payout profile or inline bank details.
/// Lifecycle: DRAFT → REVIEW (submitForReview) → ACTIVE (admin approve) or back to DRAFT (admin reject).
model Campaign {
  id          String @id @default(cuid())
  organizerId String
  organizer   User   @relation("OrganizerCampaigns", fields: [organizerId], references: [id])

  title       String
  slug        String  @unique
  description String?
  story       String?

  status CampaignStatus @default(DRAFT)

  /// Content moderation status for admin review queue (set by AI pre-screen and/or human admin).
  moderationStatus ModerationStatus @default(PENDING)
  /// Human-readable reason shown to the organiser when their campaign is rejected.
  rejectionReason  String?
  /// AI moderation notes (internal only): category scores and reasoning from the AI pre-screen.
  moderationNotes  String?

  currency      CurrencyCode @default(NGN)
  goalAmount    Decimal?     @db.Decimal(10, 2)
  /// Denormalised display cache: total payments received minus refunds, maintained by application code.
  /// Incremented on charge.success (PaystackWebhookService) and decremented on refund (RefundsService).
  /// Do NOT use for financial calculations or payout eligibility — use the CampaignBalanceLedger instead.
  currentAmount Decimal      @default(0) @db.Decimal(10, 2)

  /// Monotonic draft revision for optimistic concurrency (TTW-035).
  /// Every successful owned DRAFT mutation increments once; clients send expectedRevision.
  /// TTW-034 reuses this value as the reviewed/approved revision candidate.
  draftRevision Int @default(1)

  /// Revision stamped on successful activate (TTW-034). Resume requires equality with draftRevision.
  approvedRevision Int?

  startDate DateTime?
  endDate   DateTime?

  // Organizer payout details (Nigeria-only v1). Prefer payoutProfileId; inline fields deprecated for new flows.
  payoutBankName     String?
  payoutBankCode     String?
  payoutAccountName  String?
  payoutAccountNo    String?
  payoutProfileId    String?
  payoutProfile      UserPayoutProfile? @relation(fields: [payoutProfileId], references: [id], onDelete: SetNull)
  /// Override site payout mode for this campaign (optional).
  payoutModeOverride PayoutMode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          CampaignProduct[]
  designs           Design[]
  orderItems        OrderItem[]
  orders            Order[]
  payouts           Payout[]
  discountCampaigns DiscountCampaign[]
  ledgerEntries     CampaignBalanceLedgerEntry[]

  @@index([organizerId])
  @@index([slug])
  @@index([status])
  @@index([moderationStatus])
  @@index([createdAt])
  @@index([payoutProfileId])
  @@map("campaigns")
}

/// Immutable ledger entry for campaign balance (eligible payout = sum of credits minus debits, respecting availableAt).
model CampaignBalanceLedgerEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  entryType LedgerEntryType

  /// Positive = credit (e.g. payment settled), negative = debit (e.g. refund, payout).
  amount      Decimal      @db.Decimal(10, 2)
  currency    CurrencyCode @default(NGN)
  availableAt DateTime /// When this entry becomes eligible for payout (e.g. payment date + hold days).

  orderId  String?
  refundId String?
  payoutId String?
  metadata Json? /// Optional extra context (e.g. order total, refund reason).

  createdAt DateTime @default(now())

  /// Exactly one PAYMENT_SETTLED row per order is enforced by a partial unique index in migrations (TTW-010).
  /// Exactly one PAYOUT_RESERVED / PAYOUT_SUCCEEDED / PAYOUT_FAILED (release) per payoutId (TTW-011).
  /// Exactly one REFUND_APPLIED row per refundId is enforced by a partial unique index (TTW-013).
  @@index([campaignId])
  @@index([campaignId, availableAt])
  @@index([orderId])
  @@index([payoutId])
  @@index([refundId])
  @@map("campaign_balance_ledger_entries")
}

/// Product (and optional design) offered in a campaign. Has campaign-specific prices per currency.
model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Optional: restrict to one design or use a default design
  designId String?
  design   Design? @relation(fields: [designId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campaign selling prices z (explicit per currency)
  prices CampaignProductPrice[]

  @@unique([campaignId, productId, designId])
  @@index([campaignId])
  @@map("campaign_products")
}

/// Saved bank account for payouts. Organizers can attach to campaigns instead of inline bank fields.
/// Missing constraint: at most one profile per user may have isDefault = true. Enforce in app when setting default, or add migration: CREATE UNIQUE INDEX user_payout_profiles_one_default_per_user ON user_payout_profiles (user_id) WHERE is_default = true;
model UserPayoutProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String? // "Personal", "Church Account", etc.
  bankName      String?
  bankCode      String
  accountName   String
  accountNumber String
  /// Paystack transfer recipient code (set after first successful resolve/create)
  recipientCode String? @unique

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([userId])
  @@index([bankCode])
  @@map("user_payout_profiles")
}

/// One batch of payouts (scheduled window). Contains many Payout rows.
model PayoutRun {
  id           String          @id @default(cuid())
  scheduledFor DateTime /// When this run was scheduled to execute.
  cutoffAt     DateTime /// Settlement cutoff (orders paid before this count).
  mode         PayoutMode
  status       PayoutRunStatus @default(DRAFT)

  requestedByUserId String?
  requestedBy       User?     @relation("PayoutRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId  String?
  approvedBy        User?     @relation("PayoutRunApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  executedAt        DateTime?

  payouts Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@map("payout_runs")
}

/// Payout from platform to campaign organizer. Tracks provider, amount, status, and snapshot of destination.
model Payout {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  payoutRunId String?
  payoutRun   PayoutRun? @relation(fields: [payoutRunId], references: [id], onDelete: SetNull)

  recipientUserId String
  recipient       User   @relation("RecipientPayouts", fields: [recipientUserId], references: [id])

  provider       PaymentProvider @default(PAYSTACK)
  /// Paystack transfer reference. Unique per non-null value; multiple payouts may have null
  /// (pre-initiation). PostgreSQL unique indexes treat each NULL as distinct, so this is safe.
  providerRef    String?         @unique
  idempotencyKey String? /// For Paystack transfer idempotency.
  failureReason  String?
  rawEvent       Json? /// Webhook payload for reconciliation.

  status PayoutStatus @default(DRAFT)

  currency CurrencyCode @default(NGN)
  amount   Decimal      @db.Decimal(10, 2)

  /// Snapshot of destination at time of payout (immutable for audit).
  snapshotBankCode      String?
  snapshotAccountName   String?
  snapshotAccountMask   String? /// e.g. ***6789
  snapshotRecipientCode String?

  /// For exceptional manual adjustments: two-person approval.
  requestedByUserId  String?
  approvedByUserId   String?
  approvalReason     String?
  isManualAdjustment Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Exactly-once transfer webhook claims (TTW-011).
  providerEventClaims PayoutProviderEventClaim[]

  @@index([campaignId])
  @@index([payoutRunId])
  @@index([provider])
  @@index([status])
  @@map("payouts")
}

/// Exactly-once record that a Paystack transfer webhook event was applied to a payout (TTW-011).
model PayoutProviderEventClaim {
  id          String          @id @default(cuid())
  provider    PaymentProvider @default(PAYSTACK)
  /// e.g. `transfer.success:{providerRef}`
  businessKey String
  payoutId    String
  payout      Payout          @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  fromStatus  PayoutStatus?
  toStatus    PayoutStatus
  createdAt   DateTime        @default(now())

  @@unique([provider, businessKey])
  @@index([payoutId])
  @@map("payout_provider_event_claims")
}

/// Organizer discount/cost policy: percent or fixed discount per currency, scoped to product/variant or site-wide.
/// Missing constraints (enforce in app): (1) Exactly one of discountPercent or discountAmount must be set. (2) At most one active policy per (currency, productId, variantId) overlapping in time; prevent overlapping active defaults in application logic.
model OrganizerPricingPolicy {
  id       String       @id @default(cuid())
  currency CurrencyCode @default(NGN)

  // The organizer discount y can be defined as percent or fixed amount.
  // Exactly one should be set (enforce in application logic).
  discountPercent Float?
  discountAmount  Decimal? @db.Decimal(10, 2)

  // Scope controls what this policy applies to
  // If productId/variantId are null => site-wide default
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  isActive Boolean   @default(true)
  startAt  DateTime?
  endAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, productId, variantId, startAt], name: "uniq_policy_scope_start")
  @@index([isActive, currency])
  @@index([productId])
  @@index([variantId])
  // Prevent multiple active defaults that overlap accidentally (enforce in app)
  @@index([currency, productId, variantId, isActive])
  @@map("organizer_pricing_policies")
}

/**
 * =========================
 * Discounts & Bulk Pricing
 * =========================
 */

/// Promo or discount rule. Type PERCENTAGE/FIXED/BULK; scope ORDER/PRODUCT/VARIANT/CAMPAIGN.
/// Enforced in app at creation/update: (1) FIXED requires currency. (2) Only one active discount per subject (sitewide, or per campaign/product/variant). (3) For FIXED, one per (subject, currency). (4) PERCENTAGE and FIXED cannot both be active for the same subject. (5) valuePercent in 0..100 for PERCENTAGE; redeemedCount must not exceed maxRedemptions when set.
model Discount {
  id     String         @id @default(cuid())
  code   String?        @unique
  type   DiscountType
  status DiscountStatus @default(ACTIVE)
  scope  DiscountScope

  // For percentage: store 0..100
  // For fixed: store amount in `valueAmount` with currency
  valuePercent Float?
  valueAmount  Decimal?      @db.Decimal(10, 2)
  currency     CurrencyCode? // required when FIXED

  minOrderAmount Decimal? @db.Decimal(10, 2)

  startAt DateTime?
  endAt   DateTime?

  maxRedemptions Int?
  redeemedCount  Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       DiscountProduct[]
  variants       DiscountVariant[]
  campaigns      DiscountCampaign[]
  orderDiscounts OrderDiscount[]
  activeLocks    DiscountActiveLock[]

  @@index([status, scope])
  @@index([status, scope, startAt, endAt])
  @@map("discounts")
}

/// Links a discount to a product (when scope includes PRODUCT).
model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@map("discount_products")
}

/// Links a discount to a variant (when scope includes VARIANT).
model DiscountVariant {
  discountId String
  variantId  String
  discount   Discount       @relation(fields: [discountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([discountId, variantId])
  @@map("discount_variants")
}

/// Links a discount to a campaign (when scope includes CAMPAIGN).
model DiscountCampaign {
  discountId String
  campaignId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([discountId, campaignId])
  @@map("discount_campaigns")
}

/// Record of a discount applied to an order (amount and currency). Immutable once created.
model OrderDiscount {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])

  currency      CurrencyCode @default(NGN)
  amountApplied Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_discounts")
}

/// Quantity-tier pricing for a product or variant (e.g. 10–24 units at X per unit).
/// App validates ranges; PostgreSQL also rejects overlaps via EXCLUDE USING gist
/// (see migration ttw024_pricing_tax_snapshots). Null maxQuantity = unbounded upper.
model BulkPricing {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQuantity  Int
  maxQuantity  Int?
  currency     CurrencyCode @default(NGN)
  pricePerUnit Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate tiers for same scope:
  @@unique([productId, variantId, currency, minQuantity])
  @@index([productId])
  @@index([variantId])
  @@index([productId, minQuantity])
  @@index([variantId, minQuantity])
  @@map("bulk_pricing")
}

/// Concurrency lock for active discount exclusivity (TTW-024).
/// One row per (subjectKind, subjectId, currencyKey) while the discount is ACTIVE.
/// currencyKey is "*" for PERCENTAGE (and sitewide type mutex) or the FIXED currency code.
/// Cross-type PERCENTAGE vs FIXED conflicts are rejected by a DB trigger on insert.
model DiscountActiveLock {
  id           String @id @default(cuid())
  discountId   String
  discount     Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subjectKind  String /// SITEWIDE | CAMPAIGN | PRODUCT | VARIANT
  subjectId    String /// empty string for SITEWIDE
  currencyKey  String /// "*" or CurrencyCode

  createdAt DateTime @default(now())

  @@unique([subjectKind, subjectId, currencyKey])
  @@index([discountId])
  @@map("discount_active_locks")
}

/**
 * =========================
 * Notifications & Audit Logging
 * =========================
 */

/// Configurable routing for admin/ops alerts (email, SMS, Slack) per logical event key.
model AdminNotificationRoute {
  id       String @id @default(cuid())
  /// Logical key, e.g. "admin.order.placed" (see AdminNotificationEvents in API).
  eventKey String
  /// Multiple named routes per event (e.g. "default", "oncall").
  name     String @default("default")

  enabled Boolean @default(true)

  notifyEmail     Boolean  @default(false)
  emailRecipients String[] @default([])

  notifySms     Boolean  @default(false)
  smsRecipients String[] @default([])

  notifySlack     Boolean @default(false)
  slackWebhookUrl String?

  /// Optional Handlebars templates; variables depend on event (see docs). Empty uses built-in defaults.
  subjectTemplate   String? @db.Text
  emailBodyTemplate String? @db.Text
  smsBodyTemplate   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventKey, name])
  @@index([eventKey, enabled])
  @@map("admin_notification_routes")
}

/// Outbox for notifications (email, SMS, Slack). Processed by a worker; status and attempts tracked.
model NotificationOutbox {
  id              String              @id @default(cuid())
  eventName       String // e.g., "OrderPlaced", "PaymentConfirmed"
  channel         NotificationChannel
  recipient       String // email address, phone, slack webhook id/alias
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json // template variables
  /// Optional exactly-once key (e.g. PaymentConfirmed:{orderId}). Nulls allowed for multi-recipient admin fan-out.
  dedupeKey       String?             @unique
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?
  scheduledAt     DateTime            @default(now())
  sentAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([recipientUserId])
  @@index([status, scheduledAt])
  @@map("notification_outbox")
}

/// Immutable audit record of an action on an entity (e.g. order status change, design approval).
model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  actor       User?     @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   UserRole?

  eventName  String
  action     AuditAction
  outcome    AuditOutcome @default(SUCCESS)
  source     AuditSource  @default(SYSTEM)
  requestId  String?
  traceId    String?
  ipAddress  String?
  userAgent  String?
  entityType String // "Order", "Product", "Campaign", "Design", etc.
  entityId   String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  note       String?
  occurredAt DateTime     @default(now())

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([actorUserId, createdAt])
  @@index([eventName, createdAt])
  @@index([requestId])
  @@index([traceId])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

/**
 * =========================
 * Privacy / DSAR (TTW-025)
 * =========================
 */

/// Authenticated data-subject request (export or erasure).
model PrivacyRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   PrivacyRequestType
  status PrivacyRequestStatus @default(PENDING)

  /// Policy document version applied when the request was accepted.
  policyVersion String

  /// When set and in the future, erasure executors must not proceed.
  legalHoldUntil DateTime?

  /// Object-store key for packaged export (EXPORT only); short-lived.
  exportObjectKey String?
  exportExpiresAt DateTime?
  /// sha256 hex of export bytes (no plaintext in logs).
  exportChecksum  String?

  /// Opaque failure code for operators (no PII).
  lastErrorCode String?

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions PrivacyRequestAction[]

  @@index([userId, type, status])
  @@index([status, createdAt])
  @@map("privacy_requests")
}

/// Per-system executor evidence for a privacy request (no personal field values).
model PrivacyRequestAction {
  id        String         @id @default(cuid())
  requestId String
  request   PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Stable system code, e.g. `postgres.user`, `postgres.sessions`, `object_store.media`.
  systemCode String
  /// Outcome code, e.g. `OK`, `LEGAL_HOLD`, `PROVIDER_DEFERRED`, `FAILED`.
  outcomeCode String
  /// Non-PII counts/checksums only.
  evidence    Json?
  attempt     Int       @default(1)
  completedAt DateTime  @default(now())

  @@index([requestId, systemCode])
  @@map("privacy_request_actions")
}

/// Durable reconciliation run (TTW-015). Read-only vs business state.
model ReconciliationRun {
  id        String                  @id @default(cuid())
  kind      ReconciliationRunKind
  status    ReconciliationRunStatus @default(RUNNING)
  /// Deterministic key, e.g. `internal:2026-08-19` or `provider:2026-08-19`.
  windowKey String
  cutoffAt  DateTime
  fromAt    DateTime?
  toAt      DateTime?

  cursor           Json?
  inputSnapshotHash String?
  recordsChecked   Int @default(0)
  findingsOpen     Int @default(0)
  errorSummary     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  findings ReconciliationFinding[]
  repairs  ReconciliationRepairRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, windowKey])
  @@index([status, startedAt])
  @@index([cutoffAt])
  @@map("reconciliation_runs")
}

/// Deduplicated finding keyed by fingerprint while OPEN (TTW-015).
model ReconciliationFinding {
  id         String                      @id @default(cuid())
  runId      String
  run        ReconciliationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  domain     ReconciliationDomain
  outcome    ReconciliationOutcome
  severity   ReconciliationSeverity
  status     ReconciliationFindingStatus @default(OPEN)
  fingerprint String

  leftLabel  String
  leftValue  String
  rightLabel String
  rightValue String
  currency   String?
  unit       String?

  sourceIds Json?
  evidence  Json?
  incidentRef String?

  acknowledgedByUserId String?
  acknowledgedAt       DateTime?
  resolvedByUserId     String?
  resolvedAt           DateTime?

  repairs ReconciliationRepairRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([domain, status, severity])
  @@index([fingerprint, status])
  @@index([severity, status, createdAt])
  @@map("reconciliation_findings")
}

/// Two-person repair request for money/stock findings (TTW-015).
model ReconciliationRepairRequest {
  id        String                     @id @default(cuid())
  runId     String
  run       ReconciliationRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingId String
  finding   ReconciliationFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  domain    ReconciliationDomain
  status    ReconciliationRepairStatus @default(REQUESTED)

  commandKey String
  payload    Json?

  requestedByUserId String
  approvedByUserId  String?
  beforeEvidence    Json?
  afterEvidence     Json?
  errorSummary      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId, status])
  @@index([status, createdAt])
  @@map("reconciliation_repair_requests")
}

// OrderItem.pricingBreakdown (proposal)

// {
//   "currency": "NGN",
//   "base": {
//     "source": "VARIANT_PRICE|PRODUCT_BASE_PRICE",
//     "amount": "15000.00",
//     "includedViews": 1,
