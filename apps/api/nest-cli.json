{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "mail/templates/**/*.hbs",
        "watchAssets": false
      },
      {
        "include": "mail/assets/**/*",
        "watchAssets": false
      }
    ]
  }
}
