{
  "name": "the-tamiym-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tamiym Workshop - Custom design and fundraising platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "coverage:ratchet": "node scripts/quality/check-coverage-ratchet.mjs",
    "coverage:diff": "node scripts/quality/check-diff-coverage.mjs",
    "openapi:generate": "pnpm --filter api generate:openapi && pnpm --filter @tamiym/types generate:openapi",
    "openapi:check": "node scripts/quality/check-openapi-drift.mjs",
    "observability:validate": "node scripts/quality/validate-observability-artefacts.mjs",
    "observability:validate:test": "node --test scripts/quality/__tests__/validate-observability-artefacts.test.mjs",
    "docs:validate": "node scripts/quality/validate-documentation.mjs",
    "docs:validate:test": "node --test scripts/quality/__tests__/validate-documentation.test.mjs",
    "playwright:validate": "node scripts/quality/validate-playwright-manifest.mjs",
    "playwright:validate:test": "node --test scripts/quality/__tests__/validate-playwright-manifest.test.mjs",
    "release:preflight": "node infra/release/scripts/preflight-release.mjs",
    "release:check-migrations": "node infra/release/scripts/check-migration-artefacts.mjs",
    "release:validate:test": "node --test infra/release/scripts/__tests__/release-manifest.test.mjs infra/release/scripts/__tests__/release-preflight.test.mjs",
    "test:e2e:smoke": "playwright test --grep @smoke --project=setup --project=chromium-web --project=chromium-app --project=chromium-admin --project=chromium-journeys",
    "test:e2e:matrix": "playwright test --project=setup --project=chromium-web --project=chromium-app --project=chromium-admin --project=chromium-journeys --project=firefox-web --project=webkit-web --project=mobile-chromium-web --project=chromium-a11y --project=chromium-visual --project=mobile-visual-web",
    "test:e2e:a11y": "playwright test --project=setup --project=chromium-a11y",
    "test:e2e:visual": "playwright test --project=setup --project=chromium-visual --project=mobile-visual-web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm --filter api test:coverage && pnpm coverage:ratchet && pnpm coverage:diff && pnpm audit:prod && pnpm build",
    "prepare": "pnpm exec husky || true",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:generate": "pnpm --filter api exec prisma generate",
    "infra:cost-model": "node scripts/infrastructure/cost-model.mjs",
    "infra:budget-check": "node scripts/infrastructure/check-resource-budget.mjs",
    "infra:cost-model:test": "node --test scripts/infrastructure/__tests__/cost-model.test.mjs",
    "infra:fmt": "bash -c 'export PATH=\"$HOME/.local/bin:$PATH\"; cd infra && tofu fmt -recursive'",
    "infra:validate": "bash infra/scripts/validate-all.sh",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "audit:prod:json": "pnpm audit --prod --json > audit-prod.json || true"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.5",
      "protobufjs": ">=7.5.5",
      "ws": "^8.21.0",
      "multer": ">=2.1.0",
      "path-to-regexp": ">=8.4.0",
      "js-yaml": ">=4.3.0",
      "@redocly/openapi-core>js-yaml": "4.2.0",
      "lodash": ">=4.18.0",
      "@grpc/grpc-js": ">=1.14.4",
      "deepmerge-ts": ">=8.0.0",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "hono": ">=4.12.4",
      "@hono/node-server": ">=1.19.10",
      "tar": ">=7.5.7",
      "form-data": ">=4.0.6",
      "fast-uri": ">=3.1.4"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@turbo/gen": "^2.7.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^9.0.0"
  }
}
